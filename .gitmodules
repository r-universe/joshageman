[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "SIMPLICA"]
	path = SIMPLICA
	url = https://github.com/joshageman/simplica
[submodule "cmAnalysis"]
	path = cmAnalysis
	url = https://github.com/joshageman/cmanalysis
[submodule "gaQSAR"]
	path = gaQSAR
	url = https://github.com/joshageman/gaqsar
[submodule "twomodeclusteringGA"]
	path = twomodeclusteringGA
	url = https://github.com/joshageman/twomodeclusteringga
